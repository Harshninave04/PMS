# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/medistra-hms

# NextAuth Configuration
NEXTAUTH_SECRET=your_nextauth_secret_key_here
NEXTAUTH_URL=http://localhost:3000

# Credentials for the bootstrap super admin, created automatically on first run
# against an empty database.
DEFAULT_ADMIN_EMAIL=defaultmail
DEFAULT_ADMIN_PASSWORD=defaultpassword
DEFAULT_ADMIN_NAME=Super Admin

# First-run bootstrap.
# On the first connection to an EMPTY database the app seeds everything it needs
# to run: menus, the 39 default roles, the role hierarchy, the super admin, the
# organization and its branches, departments, designations, specializations, the
# lab/radiology/pharmacy/inventory/procurement catalogs, notification templates,
# access policies and system settings. Demo data is never created implicitly.
#
# It runs once, tracked by the "bootstrap.first_run_completed" key in the
# systemsettings collection. It never deletes or overwrites anything.
#
# Set to "true" to disable it entirely.
DISABLE_DEFAULT_BOOTSTRAP=false

# ===================================================
# Supabase S3 Storage Configuration
# ===================================================
# 1. Supabase Project URL (e.g. https://xyzabcdefg.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase S3 API Endpoint
S3_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3

# 3. Supabase S3 Access Keys (From Supabase Dashboard -> Project Settings -> Storage -> S3 Access Keys)
S3_ACCESS_KEY_ID=your_supabase_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_supabase_s3_secret_access_key

# 4. Storage Bucket Name and Region
S3_REGION=us-east-1
S3_BUCKET_NAME=medistra-documents
